# ------------------------------------------------------------------
# Oficina Connect — variáveis de ambiente
#
# 1. Copie este ficheiro para ".env.local"
# 2. Preencha os valores com os dados do seu projeto Supabase
#    (Supabase → Project Settings → API)
#
# O ficheiro .env.local NUNCA deve ser enviado para o GitHub (já está no .gitignore).
#
# ATENÇÃO: use apenas a chave "anon" / "publishable".
# NUNCA coloque aqui a chave "service_role" / "secret".
# ------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: chave PÚBLICA (site key) do Cloudflare Turnstile, para proteger o login contra robôs.
# Deixe vazio se não usar. A chave secreta vai só para o Supabase (Authentication → Attack Protection).
VITE_TURNSTILE_SITE_KEY=
